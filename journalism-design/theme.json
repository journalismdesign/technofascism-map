{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1280px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "paper", "name": "Crème", "color": "#F4EFE7" },
				{ "slug": "ink", "name": "Encre", "color": "#0A0F0E" },
				{ "slug": "accent", "name": "Cyan signal", "color": "#01FFE0" },
				{ "slug": "teal", "name": "Sarcelle logo (grands corps sur crème uniquement)", "color": "#0DD4B9" }
			]
		},
		"shadow": { "defaultPresets": false, "presets": [] },
		"border": { "radius": false },
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XXS", "size": "0.5rem" },
				{ "slug": "20", "name": "XS", "size": "1rem" },
				{ "slug": "30", "name": "S", "size": "1.5rem" },
				{ "slug": "40", "name": "M", "size": "clamp(2rem, 3.5vw, 3rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2.75rem, 5vw, 4.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(4.5rem, 9vw, 9rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(5.5rem, 11vw, 10rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter Tight (grotesque)",
					"fontFamily": "\"Inter Tight\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter Tight", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-tight-latin-wght-normal.woff2"] },
						{ "fontFamily": "Inter Tight", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/inter-tight-latin-wght-italic.woff2"] }
					]
				},
				{
					"slug": "serif",
					"name": "Newsreader italique (chutes de titres)",
					"fontFamily": "Newsreader, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Newsreader", "fontStyle": "italic", "fontWeight": "200 800", "fontDisplay": "swap", "src": ["file:./assets/fonts/newsreader-latin-standard-italic.woff2"] }
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono (étiquettes)",
					"fontFamily": "\"JetBrains Mono\", \"SF Mono\", Menlo, monospace",
					"fontFace": [
						{ "fontFamily": "JetBrains Mono", "fontStyle": "normal", "fontWeight": "100 800", "fontDisplay": "swap", "src": ["file:./assets/fonts/jetbrains-mono-latin-wght-normal.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "XS (mono)", "size": "0.6875rem", "fluid": false },
				{ "slug": "s", "name": "S", "size": "0.875rem", "fluid": false },
				{ "slug": "m", "name": "M (texte)", "size": "1.0625rem", "fluid": false },
				{ "slug": "l", "name": "L (chapô)", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.375rem" } },
				{ "slug": "xl", "name": "XL", "size": "2.25rem", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "slug": "xxl", "name": "XXL", "size": "4.25rem", "fluid": { "min": "2.375rem", "max": "4.25rem" } },
				{ "slug": "huge", "name": "Affiche", "size": "7rem", "fluid": { "min": "2.75rem", "max": "7rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|paper", "text": "var:preset|color|ink" },
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|m",
			"lineHeight": "1.5"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "clamp(1rem, 4.5vw, 4rem)", "right": "clamp(1rem, 4.5vw, 4rem)", "top": "0", "bottom": "0" }
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|ink" } }
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontWeight": "800",
					"textTransform": "uppercase",
					"lineHeight": "0.9",
					"letterSpacing": "-0.045em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|huge" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xxl" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|xl", "letterSpacing": "-0.035em", "lineHeight": "0.95" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|l", "letterSpacing": "-0.02em", "lineHeight": "1.1" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|m", "textTransform": "none", "letterSpacing": "-0.01em", "lineHeight": "1.3", "fontWeight": "700" } },
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|xs",
					"fontWeight": "400",
					"letterSpacing": "0.08em",
					"lineHeight": "1.5"
				}
			},
			"button": {
				"color": { "background": "var:preset|color|ink", "text": "var:preset|color|accent" },
				"border": { "radius": "0" },
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|s",
					"fontWeight": "500",
					"textTransform": "none",
					"letterSpacing": "0"
				},
				"spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "20px", "right": "20px" } },
				":hover": { "color": { "background": "var:preset|color|ink", "text": "var:preset|color|accent" } },
				":focus": { "color": { "background": "var:preset|color|ink", "text": "var:preset|color|accent" } }
			},
			"caption": { "typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "var:preset|font-size|xs" } }
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|s", "fontWeight": "500" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|ink" },
				"border": { "width": "1px 0 0 0" }
			},
			"core/quote": {
				"typography": { "fontFamily": "var:preset|font-family|serif", "fontStyle": "italic", "fontWeight": "400", "fontSize": "var:preset|font-size|xl", "lineHeight": "1.1", "letterSpacing": "-0.02em" },
				"border": { "left": { "color": "var:preset|color|ink", "width": "1px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25em" } }
			},
			"core/post-title": { "typography": { "fontSize": "var:preset|font-size|xxl" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-editorial", "title": "Page éditoriale (sans titre automatique)", "postTypes": ["page"] }
	]
}
